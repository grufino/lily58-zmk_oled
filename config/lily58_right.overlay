/*
 * Right half: enable the right knob as its own sensor (index 1) and disable
 * left_encoder, which upstream leaves enabled on both halves on the same pins.
 * ZMK loads only one overlay per half, so keep this in sync with lily58_left.overlay.
 */

/ {
    right_encoder: encoder_right {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };
};

&left_encoder {
    status = "disabled";
};

&sensors {
    sensors = <&left_encoder &right_encoder>;
};
